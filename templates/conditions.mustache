{{!
    @template tool_dynamic_cohorts/conditions

    A list of conditions to display.

    Classes required for JS:
    * tool-dynamic-cohorts-conditions - the container amd/src/condition_form.js delegates
      its click handler to.
    * tool-dynamic-cohorts-condition-edit - opens the condition form for that row.
    * tool-dynamic-cohorts-condition-delete - removes that row from the pending list.

    Data attributes required for JS:
    * data-sortorder - the row's position in the conditions list, read by both actions.

    Context variables required for this template:
    * conditions - A list of conditions, each with sortorder, name, description and broken.
    * hidecontrols - True if the edit and delete controls should be hidden.

    Example context (json):
    {
        "conditions": [
            {
                "sortorder": 0,
                "name": "Cohort membership",
                "description": "Users who are members of Staff cohort",
                "broken": false
            },
            {
                "sortorder": 1,
                "name": "User standard profile field",
                "description": "Users with First name is equal to Terry",
                "broken": true
            }
        ],
        "hidecontrols": false
    }
}}

<div class="tool-dynamic-cohorts-conditions p-3">
    <div id="tool-dynamic-cohorts-not-saved" class="hidden alert alert-warning">{{# str }} conditionchangesnotapplied, tool_dynamic_cohorts {{/ str }}</div>
    <table class="table table-striped table-hover">
        <thead>
        <tr>
            <th scope="col">{{# str }} name {{/ str }}</th>
            <th scope="col">{{# str }} description {{/ str }}</th>
            {{^hidecontrols}}
                <th scope="col">{{# str }} actions {{/ str }}</th>
            {{/hidecontrols}}
        </tr>
        </thead>
        <tbody>
        {{#conditions}}
            <tr>
                <td>{{#broken}}{{# pix }} i/invalid, core, {{# str }} broken, tool_dynamic_cohorts {{/ str }} {{/ pix }}{{/broken}} {{name}}</td>
                <td>{{{description}}}</td>
                {{^hidecontrols}}
                    <td>
                        <button type="button" class="btn btn-link p-0 border-0 align-baseline tool-dynamic-cohorts-condition-edit" data-sortorder="{{sortorder}}" aria-label="{{# str }} edit {{/ str }}">{{# pix }} t/edit, core {{/ pix }}</button>
                        <button type="button" class="btn btn-link p-0 border-0 align-baseline tool-dynamic-cohorts-condition-delete" data-sortorder="{{sortorder}}" aria-label="{{# str }} delete {{/ str }}">{{# pix }} t/delete, core {{/ pix }}</button>
                    </td>
                {{/hidecontrols}}
            </tr>
        {{/conditions}}
        </tbody>
    </table>
</div>

