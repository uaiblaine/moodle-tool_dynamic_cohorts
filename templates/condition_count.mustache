{{!
    @template tool_dynamic_cohorts/condition_count

    The condition count for one rule, as a control that opens the conditions modal.

    Classes required for JS:
    * tool-dynamic-cohorts-condition-view - amd/src/manage_rules.js binds the conditions
      modal to every element carrying this class.

    Data attributes required for JS:
    * data-ruleid - the rule whose conditions are fetched.

    Context variables required for this template:
    * ruleid - ID of the rule.
    * count - Number of conditions on the rule.

    The button carries an aria-label because its only visible text is a bare number, which
    on its own is not a usable accessible name.

    Example context (json):
    {
        "ruleid": "10",
        "count": 3
    }
}}
<button type="button" class="btn btn-link p-0 border-0 align-baseline tool-dynamic-cohorts-condition-view" data-ruleid="{{ruleid}}" aria-label="{{# str }} conditionsformtitle, tool_dynamic_cohorts {{/ str }}">{{count}}</button>
