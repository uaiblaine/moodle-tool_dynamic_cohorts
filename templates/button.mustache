{{!
    @template tool_dynamic_cohorts/button

    Button.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-action="addrule" - amd/src/manage_rules.js binds the add-rule modal to it and
      cancels the default navigation, so the href is only the no-JS fallback.

    Context variables required for this template:
    * url - URL of the button.
    * text - Text of the button.

    Example context (json):
    {
        "url": "https://example.com/admin/tool/dynamic_cohorts/index.php",
        "text": "Add a new rule"
    }
}}

<a href="{{url}}" class="btn btn-primary" data-action="addrule">
    {{text}}
</a>
